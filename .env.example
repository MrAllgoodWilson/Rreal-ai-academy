# ------------------------------------------------------------------
# Rreal AI Academy — environment variables
# Every integration is OPTIONAL. With nothing set, the app runs in
# "Demo mode": accounts + progress live in the browser (localStorage),
# the Coach and Sandbox use the built-in offline engine, and checkout
# starts a local trial. Fill these in to go to production.
# ------------------------------------------------------------------

# Public site URL (used for certificate verification links, emails, Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Auth, Postgres, RLS) — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Certificates — long random string used to HMAC-sign credentials.
# Generate with: openssl rand -base64 48   (REQUIRED in production)
CERT_SIGNING_SECRET=

# Claude API (Rreal Coach + Prompt Sandbox live mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs (premium coach voice; falls back to the browser's built-in voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Resend (transactional email: forgot-username, milestones)
RESEND_API_KEY=
EMAIL_FROM="Rreal AI Academy <hello@example.com>"

# LinkedIn "Add to profile" — your LinkedIn Company Page numeric ID
NEXT_PUBLIC_LINKEDIN_ORG_ID=
