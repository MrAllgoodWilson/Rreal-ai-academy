# ──────────────────────────────────────────────────────────────────────
# Rreal AI Academy — environment variables (set these in Vercel → Settings → Environment Variables)
# See docs/LAUNCH.md for exactly where each value comes from.
# ──────────────────────────────────────────────────────────────────────

# Public site URL (no trailing slash) — used for certificates, emails, Stripe redirects
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase (auto-filled if you connect the Supabase integration in Vercel) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Certificates (REQUIRED) — generate: openssl rand -base64 48 ──
CERT_SIGNING_SECRET=

# ── Admins who can publish learner-created courses (comma-separated emails) ──
ADMIN_EMAILS=

# ── Claude API: Coach, Sandbox, AI Course Creator, Playbook builder, Spanish translation ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── ElevenLabs: premium coach voices (English + Spanish) ──
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

# ── Stripe: $1/month membership ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_1UXevHK68Pw0CGHvMMNt6NeD
# Fallback checkout if STRIPE_SECRET_KEY is not set:
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/7sY5kEfff2MUb3Y5tWcQU09
# Stripe no-code customer portal link (Settings → Billing → Customer portal) — used when no secret key
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# ── Real AI video rendering (Replicate) ──
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=minimax/video-01
REPLICATE_VIDEO_INPUT={}

# ── Social accounts (Ayrshare: TikTok, Instagram, YouTube, Facebook, LinkedIn, X…) ──
AYRSHARE_API_KEY=
AYRSHARE_DOMAIN=
AYRSHARE_PRIVATE_KEY=

# ── Email (forgot-username; also set Resend as Supabase Auth SMTP) ──
RESEND_API_KEY=
EMAIL_FROM="Rreal AI Academy <hello@your-domain.com>"

# ── LinkedIn "Add to profile" — your LinkedIn Company Page numeric id ──
NEXT_PUBLIC_LINKEDIN_ORG_ID=

# ── Accredited credentials (ONLY after signing an agreement with an accredited partner) ──
ACCREDITATION_PARTNER=
ACCREDITING_BODY=
ACCREDITATION_PROVIDER_ID=
ACCREDITED_TRACKS=
CEU_PER_HOUR=0.1

# ── Fair-use quotas (protect margins at $1/month) ──
QUOTA_COACH_PER_DAY=40
QUOTA_SANDBOX_PER_DAY=25
QUOTA_COURSES_PER_MONTH=2
QUOTA_PLAYBOOKS_PER_MONTH=5
QUOTA_VIDEOS_PER_MONTH=1
QUOTA_TTS_PER_DAY=60
QUOTA_SOCIAL_POSTS_PER_DAY=10
