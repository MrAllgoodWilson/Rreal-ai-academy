// Generates supabase/seed.sql from the typed curriculum so the DB and the app never drift.
// Run: node --experimental-strip-types scripts/generate-seed.mts
import { writeFileSync } from "node:fs";
import { TRACKS } from "../src/lib/curriculum/tracks.ts";

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const lines: string[] = ["-- AUTO-GENERATED by scripts/generate-seed.mts — do not edit by hand.", "begin;"];
let ordinal = 0;
for (const t of TRACKS) {
  lines.push(`insert into public.tracks (id, level, name, certificate_title) values (${q(t.id)}, ${t.level}, ${q(t.name)}, ${q(t.certificateTitle)}) on conflict (id) do update set level = excluded.level, name = excluded.name, certificate_title = excluded.certificate_title;`);
  for (const w of t.weeks)
    for (const m of w.modules)
      for (const l of m.lessons) {
        lines.push(
          `insert into public.lessons (id, track_id, track_level, week_number, module_id, ordinal, title, xp, minutes, is_free) values (${q(l.id)}, ${q(t.id)}, ${t.level}, ${w.number}, ${q(m.id)}, ${ordinal}, ${q(l.title)}, ${l.xp}, ${l.minutes}, ${w.number === 1}) on conflict (id) do update set track_id = excluded.track_id, track_level = excluded.track_level, week_number = excluded.week_number, module_id = excluded.module_id, ordinal = excluded.ordinal, title = excluded.title, xp = excluded.xp, minutes = excluded.minutes, is_free = excluded.is_free;`,
        );
        ordinal++;
      }
}
lines.push("commit;");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n") + "\n");
console.log(`Wrote ${ordinal} lessons across ${TRACKS.length} tracks to supabase/seed.sql`);
