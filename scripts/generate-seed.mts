// Generates supabase/seed.sql from the typed curriculum so the DB and the app never drift.
// Run AFTER all migrations: node --experimental-strip-types scripts/generate-seed.mts
import { writeFileSync } from "node:fs";
import { TRACKS } from "../src/lib/curriculum/tracks.ts";
import { COURSES } from "../src/lib/curriculum/courses.ts";

const q = (s: string | undefined) => (s === undefined ? "null" : `'${s.replace(/'/g, "''")}'`);
const lines: string[] = ["-- AUTO-GENERATED by scripts/generate-seed.mts — do not edit by hand.", "begin;"];
let ordinal = 0;
const all = [...TRACKS.map((t) => ({ ...t, kind: "program" as const })), ...COURSES];
for (const t of all) {
  const kind = t.kind ?? "program";
  lines.push(
    `insert into public.tracks (id, level, name, certificate_title, kind, category, is_published) values (${q(t.id)}, ${t.level}, ${q(t.name)}, ${q(t.certificateTitle)}, ${q(kind)}, ${q(t.category)}, true) on conflict (id) do update set level = excluded.level, name = excluded.name, certificate_title = excluded.certificate_title, kind = excluded.kind, category = excluded.category;`,
  );
  for (const w of t.weeks)
    for (const m of w.modules)
      for (const l of m.lessons) {
        lines.push(
          `insert into public.lessons (id, track_id, track_level, week_number, module_id, ordinal, title, xp, minutes, is_free, track_kind) values (${q(l.id)}, ${q(t.id)}, ${t.level}, ${w.number}, ${q(m.id)}, ${ordinal}, ${q(l.title)}, ${l.xp}, ${l.minutes}, false, ${q(kind)}) on conflict (id) do update set track_id = excluded.track_id, track_level = excluded.track_level, week_number = excluded.week_number, module_id = excluded.module_id, ordinal = excluded.ordinal, title = excluded.title, xp = excluded.xp, minutes = excluded.minutes, is_free = false, track_kind = excluded.track_kind;`,
        );
        ordinal++;
      }
}
lines.push("commit;");
writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n") + "\n");
console.log(`Wrote ${ordinal} lessons across ${all.length} tracks/courses to supabase/seed.sql`);
